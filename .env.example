# Copy to .env (git-ignored) and fill in. Load with:  set -a; source .env; set +a
#
# A Confluent Cloud *Cloud resource management* API key (not a Kafka cluster key).
# Create one under Administration > API keys, owned by a user or service account
# with OrganizationAdmin (or EnvironmentAdmin + MetricsViewer) permissions.
CONFLUENT_CLOUD_API_KEY=
CONFLUENT_CLOUD_API_SECRET=
